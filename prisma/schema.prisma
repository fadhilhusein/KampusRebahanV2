generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String          @id @default(cuid())
  name       String?
  email      String          @unique
  password   String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  isAdmin    Boolean         @default(false)
  orders     Order[]
  reviews    ProductReview[]
  userOrders UserOrder[]
  resetTokens PasswordResetToken[]
  balance     Int                  @default(0)
  topUps      BalanceTopUp[]
  balanceTxns BalanceTransaction[]
  coupons     Coupon[]

  referralCode    String?              @unique
  referralBalance Int                  @default(0)
  referralClicks  Int                  @default(0)
  referredOrders  Order[]              @relation("OrderReferrer")
  commissions     ReferralCommission[]
  payouts         PayoutRequest[]
}

model Order {
  id               String         @id @default(cuid())
  userId           String
  variantId        String
  productName      String
  variantName      String
  duration         String
  type             String
  sellPrice        Int
  costPrice        Int
  quantity         Int            @default(1)
  status           OrderStatus    @default(PENDING_PAYMENT)
  paymentRef       String?
  paymentNote      String?
  emailInvite      String?
  apiOrderId       String?
  apiResponse      Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  paymentMethod    String         @default("BANK_TRANSFER")
  uniqueCode       Int            @default(0)
  gatewayExpiresAt DateTime?
  gatewayInvoiceId String?
  gatewayQrString  String?
  gatewayStatus    String?
  refundedAt       DateTime?
  // What the customer got back and how: "BALANCE" (credited to their wallet) or "MANUAL" (admin paid out directly).
  refundAmount     Int?
  refundMethod     String?
  // When the supplier confirmed delivery; drives the loyalty coupon waiting period.
  completedAt      DateTime?
  bridgeRef        String?
  bridgePaymentUrl String?        @db.Text
  bridgeStatus     String?
  bridgeExpiresAt  DateTime?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  review           ProductReview?
  referrerId       String?
  referrer         User?          @relation("OrderReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  commission       ReferralCommission?

  @@index([userId])
  @@index([status])
  @@index([referrerId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model UserOrder {
  id        String   @id @default(cuid())
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())
  orderData Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProductReview {
  id          String   @id @default(cuid())
  userId      String
  orderId     String   @unique
  productName String
  rating      Int
  testimonial String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productName])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  EXPIRED
  AWAITING_RETRY
}

model BalanceTopUp {
  id               String      @id @default(cuid())
  userId           String
  amount           Int
  status           TopUpStatus @default(PENDING)
  gatewayInvoiceId String?     @unique
  gatewayQrString  String?
  gatewayStatus    String?
  gatewayExpiresAt DateTime?
  bridgeRef        String?     @unique
  bridgePaymentUrl String?
  bridgeStatus     String?
  bridgeExpiresAt  DateTime?
  creditedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum TopUpStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model BalanceTransaction {
  id           String         @id @default(cuid())
  userId       String
  type         BalanceTxnType
  amount       Int
  balanceAfter Int
  topUpId      String?
  orderId      String?
  note         String?
  wallet       Wallet         @default(MAIN)
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
}

enum BalanceTxnType {
  TOPUP
  PURCHASE
  REFUND
  ADJUSTMENT
  COMMISSION
  COMMISSION_REVERSAL
  PAYOUT
  PAYOUT_REVERSAL
}

// MAIN = User.balance, REFERRAL = User.referralBalance
enum Wallet {
  MAIN
  REFERRAL
}

model ReferralCommission {
  id         String           @id @default(cuid())
  orderId    String           @unique
  referrerId String
  amount     Int
  status     CommissionStatus @default(CREDITED)
  createdAt  DateTime         @default(now())
  reversedAt DateTime?

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  referrer User  @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

enum CommissionStatus {
  CREDITED
  REVERSED
}

model PayoutRequest {
  id            String       @id @default(cuid())
  userId        String
  amount        Int
  method        String
  accountNumber String
  accountName   String
  status        PayoutStatus @default(PENDING)
  adminNote     String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

model Coupon {
  id         String       @id @default(cuid())
  userId     String
  reward     String       @default("GEMINI_PRO")
  code       String       @unique
  status     CouponStatus @default(ACTIVE)
  orderId    String?      @unique
  redeemedAt DateTime?
  // Set when the reward's cost was deducted from a refund, so it happens only once.
  clawedBackAt DateTime?
  clawbackAmount Int?
  // Last time a refund dropped the customer below the threshold before redeeming.
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One coupon per user per reward, enforced at the DB level.
  @@unique([userId, reward])
}

enum CouponStatus {
  ACTIVE
  REDEEMED
  // Refund dropped the total below the threshold; reactivated if the customer qualifies again.
  REVOKED
}

// Fixed-window request counters for rate limiting (lib/rateLimit.ts). Rows expire by resetAt.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
