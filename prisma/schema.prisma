generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String          @id @default(cuid())
  name       String?
  email      String          @unique
  password   String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  isAdmin    Boolean         @default(false)
  orders     Order[]
  reviews    ProductReview[]
  userOrders UserOrder[]
}

model Order {
  id               String         @id @default(cuid())
  userId           String
  variantId        String
  productName      String
  variantName      String
  duration         String
  type             String
  sellPrice        Int
  costPrice        Int
  quantity         Int            @default(1)
  status           OrderStatus    @default(PENDING_PAYMENT)
  paymentRef       String?
  paymentNote      String?
  emailInvite      String?
  apiOrderId       String?
  apiResponse      Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  paymentMethod    String         @default("BANK_TRANSFER")
  uniqueCode       Int            @default(0)
  gatewayExpiresAt DateTime?
  gatewayInvoiceId String?
  gatewayQrString  String?
  gatewayStatus    String?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  review           ProductReview?

  @@index([userId])
  @@index([status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model UserOrder {
  id        String   @id @default(cuid())
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())
  orderData Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProductReview {
  id          String   @id @default(cuid())
  userId      String
  orderId     String   @unique
  productName String
  rating      Int
  testimonial String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productName])
  @@index([userId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  EXPIRED
  AWAITING_RETRY
}
